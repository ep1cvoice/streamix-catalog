# MongoDB Atlas connection string; the database name goes before "?" (here: streamix)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/streamix?retryWrites=true&w=majority
# Signs session tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
PORT=3001
# Number of reverse proxies in front of the server: 0 locally, set on deploy
TRUST_PROXY=0
